<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.GameTunnelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Grid.Row="0"
            Title="游戏联机助手"
            Subtitle="把两台电脑接进同一个虚拟局域网 · 我的世界 / 泰拉瑞亚 / 帕鲁，不开路由器也能一起玩"
            Glyph="&#xE774;">
            <controls:ToolPageHeader.IconBackground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#2BB673" />
                    <GradientStop Offset="1" Color="#5B8DEF" />
                </LinearGradientBrush>
            </controls:ToolPageHeader.IconBackground>
            <controls:ToolPageHeader.Actions>
                <Button x:Name="DiagnosticsButton" Click="Diagnostics_Click" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                        <TextBlock FontSize="13" Text="网络检测" />
                    </StackPanel>
                </Button>
                <Button x:Name="HelpButton" Click="Help_Click" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE897;" />
                        <TextBlock FontSize="13" Text="教程" />
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,6,28,28"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="14">

                <!-- ═════════ 联机环境：我的地址 + 网里有谁 ═════════ -->
                <Border Padding="18,16" BorderThickness="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#162BB673" />
                            <GradientStop Offset="1" Color="#165B8DEF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#332BB673" />
                    </Border.BorderBrush>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="StatusIconTile" Width="52" Height="52" CornerRadius="14" Background="#262BB673" VerticalAlignment="Top">
                            <FontIcon x:Name="StatusIcon" FontSize="24" Glyph="&#xE9F5;" Foreground="#2BB673" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" FontSize="17" FontWeight="Bold" Text="正在检查联机环境…" />
                            <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="AddressRow" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="MyAddressText" FontFamily="Consolas" FontSize="20" FontWeight="Bold" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                <Button x:Name="CopyAddressButton" Click="CopyAddress_Click" Padding="10,5" CornerRadius="7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="11" Glyph="&#xE8C8;" />
                                        <TextBlock FontSize="12" Text="复制" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="LiveBadge" Padding="8,3" CornerRadius="8" Background="#262BB673" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="#2BB673" VerticalAlignment="Center" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="游戏正在监听端口" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="PeerLine" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <Button
                            x:Name="PrepareButton"
                            Grid.Column="2"
                            Click="Prepare_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="16,8"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE896;" />
                                <TextBlock x:Name="PrepareButtonText" FontSize="13" FontWeight="SemiBold" Text="准备联机环境" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <InfoBar x:Name="HealthBar" IsOpen="False" IsClosable="True" Severity="Warning" />

                <InfoBar
                    x:Name="BroadcastHint"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Informational"
                    Title="游戏里不会自动出现房间"
                    Message="Tailscale 是三层虚拟网络，只转发点对点的数据，不转发游戏发出的局域网广播（组播）——所以游戏扫描不到对方的大厅。照旧在游戏里选「直接连接 / 通过 IP 加入」，填上面的地址 + 端口（端口见下面的游戏卡）。少数走平台好友邀请的游戏（如 Steam）不受影响。" />

                <!-- ═════════ 和朋友连起来 ═════════ -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="HostCard"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="40" Height="40" CornerRadius="11" Background="#1F7C6CF0">
                                    <FontIcon FontSize="18" Glyph="&#xE7FC;" Foreground="#7C6CF0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="我当主机，邀请朋友" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="游戏跑在我这台，朋友一键进来" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="选一个游戏 → 把邀请码发给朋友 → 他进的是同一个虚拟局域网，并拿到你的联机地址。端口和游戏里的操作都会自动准备好。" />
                            <Button x:Name="StartHostButton" Click="StartHost_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="选择游戏并邀请" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        x:Name="JoinCard"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="40" Height="40" CornerRadius="11" Background="#1F5B8DEF">
                                    <FontIcon FontSize="18" Glyph="&#xE8F1;" Foreground="#5B8DEF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="我加入朋友" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="朋友当主机，我进他的虚拟网络" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="粘贴朋友发来的邀请码（连说明文字一起粘也行），没装 Tailscale 也会自动装好；进网络后照游戏卡上的端口，在游戏里用「通过 IP 加入」连他。" />
                            <Button x:Name="StartJoinButton" Click="StartJoin_Click" CornerRadius="8" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="粘贴邀请码加入" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═════════ 我要玩的游戏（端口速查 + 一键邀请） ═════════ -->
                <StackPanel x:Name="GamesSection" Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="3" Height="15" CornerRadius="2" Background="#2BB673" VerticalAlignment="Center" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="我要玩的游戏" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="点一下 = 选好端口并进入邀请流程" />
                    </Grid>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="GamesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TunnelGameCard">
                                    <Button
                                        Click="GameChip_Click"
                                        Tag="{x:Bind Self}"
                                        Padding="0"
                                        CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Width="122" Padding="12,10" Spacing="6">
                                            <Grid Height="34">
                                                <FontIcon
                                                    FontSize="16"
                                                    Glyph="{x:Bind Glyph}"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Logo, Mode=OneWay}" Stretch="Uniform" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PortText}" />
                                                <Border
                                                    Padding="5,0"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="5"
                                                    Visibility="{x:Bind HasProtocolBadge}">
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProtocolBadge}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- ═════════ 最近联机 ═════════ -->
                <StackPanel x:Name="RecentSection" Spacing="8" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="3" Height="15" CornerRadius="2" Background="#5B8DEF" VerticalAlignment="Center" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="最近联机" />
                        </StackPanel>
                        <Button x:Name="ClearRecentButton" Click="ClearRecent_Click" HorizontalAlignment="Right" Padding="10,4" CornerRadius="7" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock FontSize="12" Text="清空" />
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TunnelRecordRow">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14,11"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind GameName}" TextTrimming="CharacterEllipsis" />
                                                <Border Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" VerticalAlignment="Center">
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind RoleText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" Text="{x:Bind Address}" IsTextSelectionEnabled="True" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind DetailText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Click="RecentCopy_Click" Tag="{x:Bind Self}" Padding="10,5" CornerRadius="7">
                                                <TextBlock FontSize="12" Text="复制地址" />
                                            </Button>
                                            <Button Click="RecentInvite_Click" Tag="{x:Bind Self}" Visibility="{x:Bind InviteVisibility}" Padding="10,5" CornerRadius="7">
                                                <TextBlock FontSize="12" Text="再邀请" />
                                            </Button>
                                            <Button Click="RecentDelete_Click" Tag="{x:Bind Self}" Padding="10,5" CornerRadius="7" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <FontIcon FontSize="11" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═════════ 原理与说明 ═════════ -->
                <Border
                    Padding="16,13"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="它是怎么把两台电脑连起来的？" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            LineHeight="19">
                            <Run Text="· Tailscale 把两台电脑接进同一个虚拟局域网：每台有一个 100 开头的固定地址，TCP / UDP 游戏都能跑，不用公网 IP、不用改路由器。" />
                            <LineBreak />
                            <Run Text="· 这个虚拟网络是「三层」的：只转发点对点的数据，不转发游戏发出的局域网广播（组播）——所以游戏里不会自动冒出对方的房间，要在游戏里选「直接连接 / 通过 IP 加入」，填地址和端口。" />
                            <LineBreak />
                            <Run Text="· 打洞成功时是点对点直连（延迟接近直连），打洞失败会自动走加密中继，能玩但延迟略高——想看自己属于哪种，点右上角「网络检测」。" />
                            <LineBreak />
                            <Run Text="· 少数游戏的联机走平台自己的通道（例如 Steam 好友邀请），不受上面这条限制。" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
