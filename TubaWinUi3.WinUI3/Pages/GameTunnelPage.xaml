<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.GameTunnelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Grid.Row="0"
            Title="游戏联机助手"
            Subtitle="Tailscale 内网穿透 · 我的世界 / 泰拉瑞亚 / 帕鲁，不开路由器也能一起玩"
            Glyph="&#xE774;">
            <controls:ToolPageHeader.IconBackground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#2BB673" />
                    <GradientStop Offset="1" Color="#5B8DEF" />
                </LinearGradientBrush>
            </controls:ToolPageHeader.IconBackground>
            <controls:ToolPageHeader.Actions>
                <Button x:Name="DiagnosticsButton" Click="Diagnostics_Click" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                        <TextBlock FontSize="13" Text="网络检测" />
                    </StackPanel>
                </Button>
                <Button x:Name="HelpButton" Click="Help_Click" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE897;" />
                        <TextBlock FontSize="13" Text="教程" />
                    </StackPanel>
                </Button>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,6,28,28"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="14">

                <!-- ═════════ 环境状态 ═════════ -->
                <Border Padding="18,16" BorderThickness="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#162BB673" />
                            <GradientStop Offset="1" Color="#165B8DEF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#332BB673" />
                    </Border.BorderBrush>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="StatusIconTile" Width="52" Height="52" CornerRadius="14" Background="#262BB673" VerticalAlignment="Top">
                            <FontIcon x:Name="StatusIcon" FontSize="24" Glyph="&#xE9F5;" Foreground="#2BB673" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" FontSize="17" FontWeight="Bold" Text="正在检查联机环境…" />
                            <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="AddressRow" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="MyAddressText" FontFamily="Consolas" FontSize="20" FontWeight="Bold" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                <Button x:Name="CopyAddressButton" Click="CopyAddress_Click" Padding="10,5" CornerRadius="7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontSize="11" Glyph="&#xE8C8;" />
                                        <TextBlock FontSize="12" Text="复制" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="LiveBadge" Padding="8,3" CornerRadius="8" Background="#262BB673" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="#2BB673" VerticalAlignment="Center" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="游戏正在监听端口" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button
                            x:Name="PrepareButton"
                            Grid.Column="2"
                            Click="Prepare_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="16,8"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE896;" />
                                <TextBlock x:Name="PrepareButtonText" FontSize="13" FontWeight="SemiBold" Text="准备联机环境" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <InfoBar x:Name="HealthBar" IsOpen="False" IsClosable="True" Severity="Warning" />

                <!-- ═════════ 两个入口 ═════════ -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="HostCard"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="40" Height="40" CornerRadius="11" Background="#1F7C6CF0">
                                    <FontIcon FontSize="18" Glyph="&#xE7FC;" Foreground="#7C6CF0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="我要开房" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="我当房主，朋友来找我玩" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="选好游戏 → 生成邀请码 → 朋友粘贴就进来了。地址和教程都会自动准备好。" />
                            <Button x:Name="StartHostButton" Click="StartHost_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="开始开房" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        x:Name="JoinCard"
                        Padding="18,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="40" Height="40" CornerRadius="11" Background="#1F5B8DEF">
                                    <FontIcon FontSize="18" Glyph="&#xE8F1;" Foreground="#5B8DEF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="我要加入" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="朋友开好房了，我来找他玩" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="把房主发来的邀请码粘进来就行（从聊天软件复制后会自动识别）。没装 Tailscale 也会自动装好。" />
                            <Button x:Name="StartJoinButton" Click="StartJoin_Click" CornerRadius="8" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="加入朋友的房间" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═════════ 最近联机 ═════════ -->
                <StackPanel x:Name="RecentSection" Spacing="8" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="3" Height="15" CornerRadius="2" Background="#5B8DEF" VerticalAlignment="Center" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="最近联机" />
                        </StackPanel>
                        <Button x:Name="ClearRecentButton" Click="ClearRecent_Click" HorizontalAlignment="Right" Padding="10,4" CornerRadius="7" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <TextBlock FontSize="12" Text="清空" />
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TunnelRecordRow">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14,11"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind GameName}" TextTrimming="CharacterEllipsis" />
                                                <Border Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" VerticalAlignment="Center">
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind RoleText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" Text="{x:Bind Address}" IsTextSelectionEnabled="True" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind DetailText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Click="RecentCopy_Click" Tag="{x:Bind Self}" Padding="10,5" CornerRadius="7">
                                                <TextBlock FontSize="12" Text="复制地址" />
                                            </Button>
                                            <Button Click="RecentInvite_Click" Tag="{x:Bind Self}" Visibility="{x:Bind InviteVisibility}" Padding="10,5" CornerRadius="7">
                                                <TextBlock FontSize="12" Text="再邀请" />
                                            </Button>
                                            <Button Click="RecentDelete_Click" Tag="{x:Bind Self}" Padding="10,5" CornerRadius="7" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <FontIcon FontSize="11" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═════════ 原理与说明 ═════════ -->
                <Border
                    Padding="16,13"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="它是怎么把两台电脑连起来的？" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            LineHeight="19">
                            <Run Text="· Tailscale 会给每台电脑分配一个 100 开头的固定地址，两台电脑就像在同一个局域网里，TCP / UDP 游戏都支持。" />
                            <LineBreak />
                            <Run Text="· 房主开好游戏房间后，把「联机地址」发给朋友；朋友在游戏里直接填这个地址就能连。" />
                            <LineBreak />
                            <Run Text="· 打洞成功时是点对点直连（延迟接近直连），打洞失败会自动走加密中继，能玩但延迟略高——想看自己属于哪种，点右上角「网络检测」。" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
