<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.GameTunnelHostDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="我要开房"
    PrimaryButtonText="下一步"
    SecondaryButtonText="上一步"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="470"
        MinWidth="560"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled">

        <StackPanel Spacing="12">

            <!-- 步骤指示 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StepText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="第 1 步 / 共 3 步" />
                <TextBlock x:Name="StepNameText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="· 选择游戏" />
            </StackPanel>

            <!-- ══════════ 第 1 步：选择游戏 ══════════ -->
            <StackPanel x:Name="Step1Panel" Spacing="10">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="选一个游戏，端口和教程都会自动准备好。列表里没有的，选最右边的「自定义游戏」自己填。" />

                <GridView
                    x:Name="GameGrid"
                    MaxHeight="300"
                    SelectionChanged="GameGrid_SelectionChanged"
                    SelectionMode="Single"
                    IsItemClickEnabled="False">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="2" ItemWidth="252" ItemHeight="88" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:TunnelGameCard">
                            <Grid Padding="4,3" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="38"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <FontIcon
                                        FontSize="17"
                                        Glyph="{x:Bind Glyph}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Padding="5,0"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="5"
                                            Visibility="{x:Bind HasProtocolBadge}">
                                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProtocolBadge}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PortText}" />
                                    <TextBlock
                                        MaxLines="1"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Tagline}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 选中游戏的说明（只展示当前这一个游戏，不堆在一起） -->
                <Border
                    x:Name="GameHintCard"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="GameHintTitle" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="GameHintAction"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="GameHintNote" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel x:Name="CustomGameActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="EditCustomGameButton" Click="EditCustomGame_Click" Padding="10,5" CornerRadius="7" Content="编辑" FontSize="12" />
                            <Button x:Name="DeleteCustomGameButton" Click="DeleteCustomGame_Click" Padding="10,5" CornerRadius="7" Content="删除" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 自定义游戏内联表单（ContentDialog 不能再套 ContentDialog，所以就地编辑） -->
                <Border
                    x:Name="CustomGameForm"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CustomGameFormTitle" FontSize="13" FontWeight="SemiBold" Text="新建自定义游戏" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="只需要填游戏用的端口。不知道的话，在游戏「开服 / 开房间」时通常会显示。" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomNameBox" PlaceholderText="游戏名称，如 深岩银河" />
                            <TextBox x:Name="CustomPortBox" Grid.Column="1" PlaceholderText="端口" InputScope="Number" />
                            <ComboBox x:Name="CustomProtocolBox" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="TCP" />
                                <ComboBoxItem Content="UDP" />
                                <ComboBoxItem Content="TCP + UDP" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="CustomGameError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveCustomGameButton" Click="SaveCustomGame_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="14,7" Content="保存并选中" FontSize="13" />
                            <Button x:Name="CancelCustomGameButton" Click="CancelCustomGame_Click" CornerRadius="7" Padding="14,7" Content="取消" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════ 第 2 步：房间设置 ══════════ -->
            <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">

                <Border
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="Step2GameName" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="Step2GameMeta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="联机端口" />
                            <NumberBox
                                x:Name="PortBox"
                                Width="130"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="PortBox_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7FC;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="先在游戏里把房间开起来" />
                        </StackPanel>
                        <ItemsControl x:Name="HostStepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Top"
                                            FontSize="12"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="•" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="PortCheckIcon" FontSize="14" Glyph="&#xE9F5;" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="PortCheckText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="正在检查端口…" />
                        <Button
                            x:Name="RecheckPortButton"
                            Grid.Column="2"
                            Padding="10,5"
                            Click="RecheckPort_Click"
                            Content="重新检测"
                            CornerRadius="7"
                            FontSize="12" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ══════════ 第 3 步：邀请朋友 ══════════ -->
            <StackPanel x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">

                <Border
                    Padding="16,14"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#1F7C6CF0" />
                            <GradientStop Offset="1" Color="#1F5B8DEF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#407C6CF0" />
                    </Border.BorderBrush>
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="你的联机地址（朋友在游戏里要填的地址）" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                x:Name="RoomAddressText"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="26"
                                FontWeight="Bold"
                                IsTextSelectionEnabled="True"
                                Text="--" />
                            <Button x:Name="CopyRoomAddressButton" Click="CopyRoomAddress_Click" CornerRadius="7" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                    <TextBlock FontSize="13" Text="复制" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="RoomStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <controls:GameTunnelInvitePanel x:Name="InvitePanel" />

                <Expander Header="朋友加入后，在游戏里怎么操作？" HorizontalAlignment="Stretch">
                    <StackPanel Padding="0,8" Spacing="6">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="朋友侧" />
                        <ItemsControl x:Name="GuestStepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Top" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="•" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="GuestEntryText" Margin="0,4,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander Header="朋友连不上？按顺序检查这几项" HorizontalAlignment="Stretch">
                    <StackPanel Padding="0,8" Spacing="6">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="1. 朋友要先运行一键加入脚本（或粘贴邀请码），加入成功后他在游戏里才有这个地址。" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="2. 你的游戏必须已经开启房间，并且监听上面这个端口（本页会自动检测）。" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="3. 用「网络检测」看看是不是走了中继——中继也能玩，但延迟会高一些。" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="4. 还是不行就让朋友先停掉安全软件的网络防护试一次，个别安全软件会拦截 Tailscale。" />
                    </StackPanel>
                </Expander>

                <TextBlock x:Name="FirewallText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
